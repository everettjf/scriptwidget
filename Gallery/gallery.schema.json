{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scriptwidget.app/schemas/gallery-1.json",
  "title": "ScriptWidget Gallery 1.0 index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "repository", "items"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "repository": { "type": "string", "pattern": "^https://github\\.com/" },
    "items": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "name", "version", "summary", "symbol", "author", "license", "tags", "minimumRuntimeVersion", "sourceURL", "featured", "files"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]{2,127}$" },
          "kind": { "enum": ["widget", "skill"] },
          "name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
          "summary": { "type": "string", "minLength": 1, "maxLength": 240 },
          "symbol": { "type": "string", "minLength": 1, "maxLength": 80 },
          "author": { "type": "string", "minLength": 1, "maxLength": 120 },
          "license": { "type": "string", "minLength": 1, "maxLength": 40 },
          "tags": { "type": "array", "maxItems": 20, "uniqueItems": true, "items": { "type": "string" } },
          "minimumRuntimeVersion": { "const": "1.0" },
          "sourceURL": { "type": "string", "pattern": "^https://github\\.com/" },
          "featured": { "type": "boolean" },
          "files": {
            "type": "array",
            "minItems": 2,
            "maxItems": 500,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "url", "sha256", "bytes"],
              "properties": {
                "path": { "type": "string", "pattern": "^[^/\\\\].*" },
                "url": { "type": "string", "pattern": "^https://raw\\.githubusercontent\\.com/" },
                "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "bytes": { "type": "integer", "minimum": 1, "maximum": 26214400 }
              }
            }
          }
        }
      }
    }
  }
}
