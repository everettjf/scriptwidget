{
  "name": "@scriptwidget/preview-engine",
  "version": "0.19.0",
  "private": true,
  "type": "module",
  "description": "Browser and Node execution of ScriptWidget JSX packages that mirrors the native JavaScriptCore runtime contract.",
  "bin": {
    "scriptwidget-preview": "./bin/scriptwidget-preview.mjs",
    "scriptwidget-mcp": "./bin/scriptwidget-mcp.mjs"
  },
  "exports": {
    ".": "./src/index.js",
    "./node": "./src/node.js"
  },
  "scripts": {
    "test": "node --test --test-timeout=180000 test/*.test.js",
    "build": "node scripts/build-browser.mjs",
    "coverage": "node scripts/coverage-report.mjs",
    "compare": "node scripts/compare-snapshots.mjs"
  }
}
