<Page x:Class="ScriptWidget.Studio.Pages.EditorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:s="using:ScriptWidget.Studio.Services"
      xmlns:ai="using:ScriptWidget.Studio.AI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Padding="16,12,20,12" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Click="OnBack" ToolTipService.ToolTip="{s:T Key=action.back}" AutomationProperties.Name="{s:T Key=action.back}" Padding="8,6">
                <FontIcon Glyph="&#xE72B;" FontSize="14" />
            </Button>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                <TextBlock x:Name="TitleText" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="StatusText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <ToggleButton x:Name="AiToggle" Click="OnAi" Content="{s:T Key=nav.ai}" />
                <Button Click="OnFormat" Content="{s:T Key=action.format}" />
            </StackPanel>
            <Button Grid.Column="3" Click="OnExport" Content="{s:T Key=action.export}" />
            <Button Grid.Column="4" Click="OnOpenFolder" Content="{s:T Key=action.openFolder}" />
            <DropDownButton x:Name="AddButton" Grid.Column="5" Content="{s:T Key=action.addToDesktop}" />
            <Button Grid.Column="6" Click="OnSave" Style="{StaticResource AccentButtonStyle}" Content="{s:T Key=action.save}">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control" Key="S" />
                </Button.KeyboardAccelerators>
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>

            <!-- Files -->
            <Grid Padding="12,0,8,12" RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{s:T Key=editor.files}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="8,0,0,0" />
                <ListView x:Name="Files" Grid.Row="1" SelectionMode="Single" SelectionChanged="OnFileSelected" AutomationProperties.Name="{s:T Key=editor.files}" />
                <Button Grid.Row="2" Click="OnNewFile" Content="{s:T Key=action.newFile}" HorizontalAlignment="Stretch" />
            </Grid>

            <!-- Code -->
            <Grid Grid.Column="1" CornerRadius="8,0,0,0" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,0">
                <WebView2 x:Name="Web" DefaultBackgroundColor="Transparent" />
                <TextBlock x:Name="EditorMessage" Visibility="Collapsed" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>

            <!-- Preview -->
            <Grid x:Name="PreviewPane" Grid.Column="2" Padding="20,0,20,16" RowSpacing="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,0" Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="8" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{s:T Key=editor.preview}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                    <ComboBox x:Name="Family" Grid.Column="1" MinWidth="110" SelectionChanged="OnPreviewOptionChanged" AutomationProperties.Name="{s:T Key=editor.size}" />
                    <ToggleButton x:Name="Dark" Grid.Column="2" Click="OnPreviewOptionChanged" Content="{s:T Key=editor.dark}" />
                </Grid>
                <Grid Grid.Row="1" CornerRadius="10" MinHeight="200" Padding="12" Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}">
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                        <Image x:Name="PreviewImage" Stretch="Fill" AutomationProperties.Name="{s:T Key=editor.preview}" />
                    </Viewbox>
                    <ProgressRing x:Name="PreviewBusy" IsActive="False" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top" />
                </Grid>
                <TextBox x:Name="Parameter" Grid.Row="2" Header="{s:T Key=editor.parameter}" AutomationProperties.Name="{s:T Key=editor.parameter}" PlaceholderText="{s:T Key=editor.parameter.hint}" TextChanged="OnParameterChanged" />
                <InfoBar x:Name="ErrorBar" Grid.Row="3" Severity="Error" IsClosable="False" IsOpen="False" />
                <Grid Grid.Row="4" RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{s:T Key=editor.logs}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ScrollViewer Grid.Row="1" CornerRadius="6" Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}" Padding="10,8">
                        <TextBlock x:Name="Logs" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </ScrollViewer>
                </Grid>
            </Grid>
            <ai:AiPanel x:Name="Assistant" Grid.Column="2" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Page>
