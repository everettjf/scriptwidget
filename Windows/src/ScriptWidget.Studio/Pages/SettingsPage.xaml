<Page x:Class="ScriptWidget.Studio.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:s="using:ScriptWidget.Studio.Services">
    <Page.Resources>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="ColumnSpacing" Value="16" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Page.Resources>
    <ScrollViewer>
        <StackPanel Padding="32,28,32,32" Spacing="8" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="{s:T Key=settings.title}" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,12" />

            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock Text="{s:T Key=settings.refresh}" />
                    <TextBlock Text="{s:T Key=settings.refresh.detail}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <ComboBox x:Name="Refresh" Grid.Column="1" MinWidth="150" VerticalAlignment="Center" SelectionChanged="OnRefreshChanged" />
            </Grid>

            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock Text="{s:T Key=settings.lock}" />
                    <TextBlock Text="{s:T Key=settings.lock.detail}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch x:Name="Lock" Grid.Column="1" Toggled="OnLockToggled" OnContent="" OffContent="" MinWidth="0" />
            </Grid>

            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock Text="{s:T Key=settings.pause}" />
                    <TextBlock Text="{s:T Key=settings.pause.detail}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch x:Name="Pause" Grid.Column="1" Toggled="OnPauseToggled" OnContent="" OffContent="" MinWidth="0" />
            </Grid>

            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock Text="{s:T Key=settings.startup}" />
                    <TextBlock Text="{s:T Key=settings.startup.detail}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch x:Name="StartAtLogin" Grid.Column="1" Toggled="OnStartupToggled" OnContent="" OffContent="" MinWidth="0" />
            </Grid>

            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock Text="{s:T Key=settings.data}" />
                    <TextBlock Text="{s:T Key=settings.data.detail}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Click="OnOpenData" Content="{s:T Key=action.openFolder}" VerticalAlignment="Center" />
            </Grid>

            <TextBlock Text="{s:T Key=settings.about}" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,20,0,4" />
            <Grid Style="{StaticResource Row}">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="VersionText" />
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <HyperlinkButton NavigateUri="https://atomsprout.com/scriptwidget/" Content="{s:T Key=settings.website}" Padding="0" />
                        <HyperlinkButton NavigateUri="https://github.com/everettjf/scriptwidget/tree/main/docs" Content="{s:T Key=settings.docs}" Padding="0" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
