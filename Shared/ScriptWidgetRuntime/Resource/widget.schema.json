{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scriptwidget.app/schemas/widget-2.json",
  "title": "ScriptWidget Package 2.0 manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "id", "name", "version", "runtimeVersion", "entry", "supportedFamilies", "permissions", "networkDomains"],
  "properties": {
    "formatVersion": { "const": 2 },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]{2,127}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "runtimeVersion": { "const": "1.0" },
    "entry": { "type": "string", "pattern": "^[^/\\\\].*\\.(?:js|jsx)$" },
    "supportedFamilies": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "enum": ["systemSmall", "systemMedium", "systemLarge", "systemExtraLarge", "accessoryCircular", "accessoryRectangular", "accessoryInline"] }
    },
    "permissions": {
      "type": "array", "uniqueItems": true,
      "items": { "enum": ["network", "location", "health", "storage", "files"] }
    },
    "networkDomains": {
      "type": "array", "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(?:\\*\\.)?[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$" }
    },
    "plugins": {
      "type": "array", "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]{2,127}$" }
    },
    "description": { "type": "string" },
    "category": { "type": "string" },
    "tags": { "type": "array", "maxItems": 20, "items": { "type": "string" } },
    "icon": { "type": "string" },
    "preview": { "type": "string" },
    "author": {
      "type": "object", "additionalProperties": false, "required": ["name"],
      "properties": { "name": { "type": "string" }, "url": { "type": "string", "format": "uri", "pattern": "^https://" } }
    },
    "license": { "type": "string" }
  }
}
