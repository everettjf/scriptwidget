{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scriptwidget.app/schemas/widget-2.json",
  "title": "ScriptWidget Package 2.0 manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "id", "name", "version", "runtimeVersion", "entry", "supportedFamilies", "permissions", "networkDomains"],
  "properties": {
    "formatVersion": { "const": 2 },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]{2,127}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 240, "description": "Nonreserved package directory name: at most 80 grapheme clusters and 240 UTF-8 bytes. No leading dot, path separators, drive prefix, control characters (except ZWNJ/ZWJ), or __Build (case insensitive). Runtime validation enforces grapheme and byte limits." },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "runtimeVersion": { "const": "1.0" },
    "minimumRuntimeVersion": {"type": ["string", "null"], "pattern": "^(0|[1-9][0-9]{0,2})\\.(0|[1-9][0-9]{0,2})$", "description": "Optional minimum native public API version (major.minor), separate from the Package 2.0 runtimeVersion ABI. Future/incompatible requirements fail closed."},
    "timeline": {
      "type": ["object", "null"], "additionalProperties": false, "required": ["dailyTimes"],
      "properties": {
        "dailyTimes": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"}},
        "timeZone": {"type": ["string", "null"], "maxLength": 128}
      },
      "description": "Sorted local daily transitions; at most five entries including now. Requires Runtime 1.3."
    },
    "entry": { "type": "string", "pattern": "^[^/\\\\].*\\.(?:js|jsx)$" },
    "supportedFamilies": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "enum": ["systemSmall", "systemMedium", "systemLarge", "systemExtraLarge", "systemExtraLargePortrait", "accessoryCircular", "accessoryRectangular", "accessoryInline"] }
    },
    "permissions": {
      "type": "array", "uniqueItems": true,
      "items": { "enum": ["network", "location", "health", "calendar", "reminders", "remindersWrite", "photos", "services", "music", "storage", "icloud", "files"] }
    },
    "networkDomains": {
      "type": "array", "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(?:\\*\\.)?[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$" }
    },
    "plugins": {
      "type": "array", "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]{2,127}$" }
    },
    "actions": {
      "type": "array", "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "title", "systemImage", "function"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]{0,63}$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 40 },
          "description": { "type": "string", "maxLength": 160 },
          "systemImage": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]{0,79}$" },
          "function": { "type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]{0,63}$" }
        }
      }
    },
    "controls": {
      "type": "array", "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "type", "title", "systemImage"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]{0,63}$" },
          "type": { "enum": ["button", "toggle"] },
          "title": { "type": "string", "minLength": 1, "maxLength": 40 },
          "subtitle": { "type": "string", "maxLength": 80 },
          "systemImage": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]{0,79}$" },
          "action": { "type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]{0,63}$" },
          "actionID": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]{0,63}$" },
          "stateKey": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" }
        },
        "allOf": [
          { "oneOf": [{ "required": ["action"] }, { "required": ["actionID"] }] },
          { "if": { "properties": { "type": { "const": "toggle" } } }, "then": { "required": ["stateKey"] } },
          { "if": { "properties": { "type": { "const": "button" } } }, "then": { "not": { "required": ["stateKey"] } } }
        ]
      }
    },
    "pushUpdates": {
      "type": "object", "additionalProperties": false,
      "required": ["registrationURL", "channel"],
      "properties": {
        "registrationURL": { "type": "string", "format": "uri", "pattern": "^https://" },
        "channel": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" }
      }
    },
    "description": { "type": "string" },
    "category": { "type": "string" },
    "tags": { "type": "array", "maxItems": 20, "items": { "type": "string" } },
    "icon": { "type": "string" },
    "preview": { "type": "string" },
    "author": {
      "type": "object", "additionalProperties": false, "required": ["name"],
      "properties": { "name": { "type": "string" }, "url": { "type": "string", "format": "uri", "pattern": "^https://" } }
    },
    "license": { "type": "string" }
  }
}
