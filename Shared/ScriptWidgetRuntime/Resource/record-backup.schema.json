            "const": "habitStreak"
          }
        }
      },
      "then": {
        "properties": {
          "values": {
            "propertyNames": {
              "enum": [
                "habitStreak.v2",
                "habit.lastDate",
                "habit.streak",
                "recordTemplate.config.v1"
              ]
            }
          },
          "unsupportedValues": {
            "propertyNames": {
              "enum": [
                "habitStreak.v2",
                "habit.lastDate",
                "habit.streak",
