<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%lld changed lines</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld changed line</string>
			<key>other</key>
			<string>%lld changed lines</string>
		</dict>
	</dict>
	<key>%lld lines added, %lld removed</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@added@, %2$#@removed@</string>
		<key>added</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld line added</string>
			<key>other</key>
			<string>%lld lines added</string>
		</dict>
		<key>removed</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld removed</string>
			<key>other</key>
			<string>%lld removed</string>
		</dict>
	</dict>
	<key>%lld lines added, %lld removed. Show the changes.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@added@, %2$#@removed@. Show the changes.</string>
		<key>added</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld line added</string>
			<key>other</key>
			<string>%lld lines added</string>
		</dict>
		<key>removed</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld removed</string>
			<key>other</key>
			<string>%lld removed</string>
		</dict>
	</dict>
	<key>%lld skills on</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld skill on</string>
			<key>other</key>
			<string>%lld skills on</string>
		</dict>
	</dict>
	<key>%lld tokens</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld token</string>
			<key>other</key>
			<string>%lld tokens</string>
		</dict>
	</dict>
	<key>%lld versions · %@</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@versions@ · %2$@</string>
		<key>versions</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld version</string>
			<key>other</key>
			<string>%lld versions</string>
		</dict>
	</dict>
	<key>Fixed automatically %lld times</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Fixed automatically %lld time</string>
			<key>other</key>
			<string>Fixed automatically %lld times</string>
		</dict>
	</dict>
	<key>⋯ %lld unchanged lines</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>⋯ %lld unchanged line</string>
			<key>other</key>
			<string>⋯ %lld unchanged lines</string>
		</dict>
	</dict>
</dict>
</plist>
