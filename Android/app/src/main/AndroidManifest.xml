<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- $location: foreground only. Background location is never requested. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- $calendar: reads inside the user's selection; writes only for events a widget created. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- $notifications: local reminders with inexact alarms, re-armed after a reboot. No exact-alarm permission. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Live Activities: lets the ongoing progress notification be promoted to a Live Update (Android 16 and later). -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- $photos uses the system Photo Picker and needs no storage permission. -->
    <!-- $health: read-only Health Connect access for the record types the API uses. No write permission is declared. -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_HYDRATION" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <!-- Widgets refresh while the app is closed; without this Health Connect only answers a visible app. -->
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" />

    <queries>
        <!-- The Health Connect provider app on devices where it is not part of the system. -->
        <package android:name="com.google.android.apps.healthdata" />
    </queries>
    <!-- $alarms reuses the inexact alarms and notifications above. $documents uses the Storage Access
         Framework and $contacts the system contact picker: neither needs a storage or contacts permission. -->

    <application
        android:name=".ScriptWidgetApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ScriptWidget">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Open or share a .swt package to install it. -->
            <intent-filter android:label="@string/install_package">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/x-zip-compressed" />
            </intent-filter>
            <intent-filter android:label="@string/install_package">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="scriptwidget" />
            </intent-filter>
        </activity>

        <!-- Health Connect shows this screen when the user asks why ScriptWidget wants health data. -->
        <activity
            android:name=".HealthRationaleActivity"
            android:exported="true"
            android:label="@string/health_rationale_title">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>
        <!-- Android 14 and later open the same screen from the system permission usage page. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".HealthRationaleActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".widget.WidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.ScriptWidget">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver android:name=".widget.SmallWidgetProvider" android:exported="true" android:label="@string/widget_small">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_small" />
        </receiver>
        <receiver android:name=".widget.MediumWidgetProvider" android:exported="true" android:label="@string/widget_medium">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_medium" />
        </receiver>
        <receiver android:name=".widget.LargeWidgetProvider" android:exported="true" android:label="@string/widget_large">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_large" />
        </receiver>

        <!-- For tablets and unfolded foldables; phones list it but their grid is narrower. -->
        <receiver android:name=".widget.ExtraLargeWidgetProvider" android:exported="true" android:label="@string/widget_extra_large">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_extra_large" />
        </receiver>

        <receiver android:name=".widget.WidgetActionReceiver" android:exported="false" />
        <receiver android:name=".widget.WidgetAlarmReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- Posts $notifications reminders and re-arms their alarms after boot, update or a clock change. -->
        <receiver android:name=".SystemNotificationReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
        <receiver android:name=".ui.WidgetPinnedReceiver" android:exported="false" />
        <!-- $music: Android only lets an enabled notification listener read the active media session.
             The user enables it in system settings; the service itself reads no notifications. -->
        <service android:name="com.everettjf.scriptwidget.core.system.MediaSessionAccessService"
            android:exported="true"
            android:label="@string/music_access_service"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <activity android:name=".widget.LinkActivity" android:exported="false" android:excludeFromRecents="true"
            android:taskAffinity="" android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!--
            Package controls as Quick Settings tiles. Android needs tiles declared here, so eight slots exist
            and the Controls screen assigns a package control to each. Exported because the system binds them;
            BIND_QUICK_SETTINGS_TILE keeps every other app out.
        -->
        <service android:name=".actions.ControlTileService1" android:exported="true" android:label="@string/control_tile_1"
            android:icon="@drawable/ic_control_generic" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <service android:name=".actions.ControlTileService2" android:exported="true" android:label="@string/control_tile_2"
            android:icon="@drawable/ic_control_generic" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <service android:name=".actions.ControlTileService3" android:exported="true" android:label="@string/control_tile_3"
            android:icon="@drawable/ic_control_generic" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <service android:name=".actions.ControlTileService4" android:exported="true" android:label="@string/control_tile_4"
            android:icon="@drawable/ic_control_generic" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <service android:name=".actions.ControlTileService5" android:exported="true" android:label="@string/control_tile_5"
            android:icon="@drawable/ic_control_generic" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <service android:name=".actions.ControlTileService6" android:exported="true" android:label="@string/control_tile_6"
            android:icon="@drawable/ic_control_generic" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <service android:name=".actions.ControlTileService7" android:exported="true" android:label="@string/control_tile_7"
            android:icon="@drawable/ic_control_generic" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <service android:name=".actions.ControlTileService8" android:exported="true" android:label="@string/control_tile_8"
            android:icon="@drawable/ic_control_generic" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>

        <!-- Launcher shortcuts for declared actions start this invisible activity, which hands off to the receiver. -->
        <activity android:name=".actions.ShortcutActionActivity" android:exported="false" android:excludeFromRecents="true"
            android:noHistory="true" android:taskAffinity="" android:theme="@android:style/Theme.NoDisplay" />
        <receiver android:name=".actions.SurfaceActionReceiver" android:exported="false" />
        <!-- Ends a Live Update at its deadline, from its End button, or when the user dismisses it. -->
        <receiver android:name=".live.LiveUpdateReceiver" android:exported="false" />
    </application>
</manifest>
