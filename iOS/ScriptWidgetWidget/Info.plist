<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSAppleMusicUsageDescription</key>
	<string>Show the current Music app track and playback state in your widgets. ScriptWidget does not scan or change your music library.</string>
	<key>ScriptWidgetServiceKeychainGroup</key>
	<string>$(AppIdentifierPrefix)com.everettjf.scriptwidget.services</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>ScriptWidget</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.widgetkit-extension</string>
	</dict>
	<key>NSHealthShareUsageDescription</key>
	<string>Allow ScriptWidget to read Health data for widget templates.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Allow ScriptWidget to update Health data if you enable it.</string>
	<key>NSWidgetWantsLocation</key>
	<true/>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Allow ScriptWidget to access your location for widget templates.</string>
	<key>NSLocationTemporaryUsageDescriptionDictionary</key>
	<dict>
		<key>ScriptWidgetLocation</key>
		<string>Allow ScriptWidget to request temporary full-accuracy location for widgets.</string>
	</dict>
	<key>UIAppFonts</key>
	<array>
		<string>New.ttf</string>
		<string>Unispace.ttf</string>
		<string>OneSlot.ttf</string>
		<string>Monofonto.ttf</string>
		<string>Larabiefont Free.ttf</string>
		<string>Apple ][.ttf</string>
	</array>
	<key>NSContactsUsageDescription</key>
	<string>Select contacts to share with your chosen widgets.</string>
	<key>NSHomeKitUsageDescription</key>
	<string>Read selected home accessories and run selected controls or scenes from widgets.</string>
	<key>NSAlarmKitUsageDescription</key>
	<string>Schedule alarms and timers you explicitly request from a widget.</string>
</dict>
</plist>
